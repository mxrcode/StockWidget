   <item>
    <widget class="QWidget" name="frame" native="true">
     <property name="styleSheet">
      <string notr="true">#frame {
	background-color: #4C5844;
	border: 1px solid #7A836E;
}
QWidget {
	background-color: #4C5844;
	color: #D9D9D9;
}
QLabel, QCheckBox, QRadioButton {
	background: transparent;
}
QLabel[section=&quot;true&quot;] {
	color: #899581;
	font-size: 11pt;
}
QLabel[hint=&quot;true&quot;] {
	color: #899581;
}
#windowName {
	color: #899581;
	font-size: 12pt;
}
#line {
	background-color: #7A836E;
	border: none;
	min-height: 1px;
	max-height: 1px;
}
QPushButton {
	background-color: #4C5844;
	color: #899581;
	border: 1px solid #7A836E;
	padding: 6px 16px;
	font-size: 11pt;
	font-weight: bold;
}
QPushButton:hover {
	background-color: #3E4637;
}
QPushButton:checked {
	background-color: #3E4637;
	color: #B8B857;
	border-color: #B8B857;
}
QPushButton:disabled {
	color: #6B7559;
}
QPushButton[quote=&quot;true&quot;] {
	padding: 3px 10px;
	font-size: 9pt;
}
#closeButton {
	border: none;
	border-left: 1px solid #7A836E;
	padding: 0px;
}
QLineEdit, QListWidget, QTreeWidget, QComboBox {
	background-color: #3E4637;
	color: #D9D9D9;
	border: 1px solid #7A836E;
	padding: 4px;
	selection-background-color: #6B7559;
	selection-color: #FFFFFF;
}
QListWidget::item, QTreeWidget::item {
	padding: 3px;
}
QListWidget::item:selected, QTreeWidget::item:selected {
	background-color: #6B7559;
	color: #FFFFFF;
}
QHeaderView::section {
	background-color: #3E4637;
	color: #899581;
	border: none;
	border-bottom: 1px solid #7A836E;
	padding: 4px;
}
QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: right;
	width: 29px;
	border-left: 1px solid #7A836E;
}
QComboBox::down-arrow {
	image: url(:/img/down_arrow.svg);
	width: 14px;
	height: 14px;
}
QComboBox QAbstractItemView {
	background-color: #3E4637;
	color: #D9D9D9;
	border: 1px solid #7A836E;
	selection-background-color: #6B7559;
}
QTabWidget::pane {
	border: 1px solid #7A836E;
	top: -1px;
}
QTabBar::tab {
	background-color: #4C5844;
	color: #899581;
	border: 1px solid #7A836E;
	padding: 6px 18px;
	margin-right: 4px;
	font-size: 10pt;
}
QTabBar::tab:selected {
	color: #B8B857;
	border-bottom-color: #4C5844;
}
QTabBar::tab:hover {
	background-color: #3E4637;
}
QRadioButton::indicator, QCheckBox::indicator {
	width: 12px;
	height: 12px;
	background-color: #3E4637;
	border: 1px solid #7A836E;
}
QRadioButton::indicator:checked, QCheckBox::indicator:checked {
	background-color: #B8B857;
}
QRadioButton:checked, QCheckBox:checked, QRadioButton:hover, QCheckBox:hover {
	color: #B8B857;
}
QRadioButton:disabled {
	color: #6B7559;
}
QScrollBar:vertical {
	background: #3E4637;
	width: 10px;
	margin: 0px;
	border: none;
}
QScrollBar::handle:vertical {
	background: #7A836E;
	min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
	background: none;
}
QToolTip {
	background-color: #3E4637;
	color: #D9D9D9;
	border: 1px solid #7A836E;
}</string>
